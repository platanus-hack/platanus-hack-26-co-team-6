# ─────────────────────────────────────────────────────────────
# PULSO — variables de entorno
# Copiar a .env.local (NO se commitea). Todo es opcional:
# si una variable falta, el sistema cae a modo mock y sigue corriendo.
# ─────────────────────────────────────────────────────────────

# ── Acceso a las consolas (todos) ────────────────────────────
# Las consolas /campo, /hospital y /crue exigen sesión: core sirve dictado
# clínico y coordenadas de paciente, y el webhook obliga a exponerlo a
# internet. Si lo dejas en blanco, core imprime una contraseña aleatoria al
# arrancar — nunca arranca abierto.
OPERADOR_PASSWORD=
# Firma de la cookie de sesión. openssl rand -hex 32
SESION_SECRET=

# Identidad real (tarea 1.3). El turno compartido sigue abierto mientras esto
# no diga 'false'; los actores individuales se siembran con PULSO_ACTORES.
# Detalle y formato en apps/backend/core/env.example.
# PULSO_AUTH_LEGACY=true
# PULSO_ACTORES=

# ── Neid (AI/LLM) ────────────────────────────────────────────
# https://console.anthropic.com  → API Keys
ANTHROPIC_API_KEY=

# ── Voz (STT/TTS) — van en apps/backend/ai-core/.env ─────────
# NO aquí y NO en core: ai-core es el único servicio que habla con los
# proveedores de voz. Ver apps/backend/ai-core/env.example.
#   ELEVENLABS_API_KEY   STT + TTS con una sola llave (default)
#   DEEPGRAM_API_KEY     plan B de STT
# Sin ninguna, /campo dicta con la Web Speech API del navegador — que NO
# existe en Safari/iOS. GET /capacidades dice en qué modo está.

# ── Plazos ───────────────────────────────────────────────────
# Segundos antes de que una solicitud venza y pase al siguiente candidato.
# Default 45. Bájalo para ensayar el demo sin esperar.
# HANDSHAKE_TIMEOUT_S=45

# ── Zaid (Backend/Datos) ─────────────────────────────────────
# https://supabase.com → New Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Juan (Frontend) + Zaid (ETA con trafico) ─────────────────
# https://account.mapbox.com → Tokens (el token publico pk.* sirve para ambos)
NEXT_PUBLIC_MAPBOX_TOKEN=

# ── Sebas (Handshake) ────────────────────────────────────────
# Telegram: hablar con @BotFather → /newbot → copiar el token
TELEGRAM_BOT_TOKEN=
# chat_id del "jefe de urgencias" del demo.
# Se saca escribiendole al bot y luego abriendo:
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID_DEMO=
# Secreto del webhook. OBLIGATORIO si registras el webhook: sin el, core lo
# rechaza todo. Es lo que impide que un desconocido finja un "el hospital
# acepto". Se lo pasas a Telegram en setWebhook(secret_token=...).
#   openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# WhatsApp Cloud API (opcional, es la vitrina)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO_DEMO=
# Cadena que TU inventas y le repites a Meta al registrar el webhook.
# No la dejes en un valor conocido: este repo es publico.
WHATSAPP_VERIFY_TOKEN=

# ── Demo ─────────────────────────────────────────────────────
# true = sin aleatoriedad, todo determinista. Dejar en true para el pitch.
NEXT_PUBLIC_MODO_DEMO=true
