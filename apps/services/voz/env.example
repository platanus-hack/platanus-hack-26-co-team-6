# voz — configuración. Copiar a .env y ajustar.
# Todo tiene default en código, así que el servicio arranca sin .env.

LOG_LEVEL=INFO
PORT=8090

# ── Hacia adentro ────────────────────────────────────────────────
AI_CORE_BASE_URL=http://127.0.0.1:8000
CORE_BASE_URL=http://127.0.0.1:3001

# core niega por defecto: expone dictado clínico, diagnóstico y las
# coordenadas del paciente. Es la MISMA contraseña de turno que usan las
# consolas (OPERADOR_PASSWORD en apps/backend/core/.env).
# Vacía = no se manda Authorization, para un core sin el guard activo.
CORE_PASSWORD=
TIMEOUT_IA_S=30
TIMEOUT_CORE_S=10

# ── URL pública ──────────────────────────────────────────────────
# Donde Twilio y Meta pueden alcanzarnos.
#   local:  ngrok http 8090  → pega la URL https que te dé
#   Render: la URL del servicio (el blueprint la inyecta sola)
# Twilio la NECESITA: abre un WebSocket de vuelta para el audio.
URL_PUBLICA=

# ── WhatsApp ─────────────────────────────────────────────────────
# meta = Cloud API directo · kapso = a través de Kapso
WHATSAPP_PROVEEDOR=meta

# Cadena que TÚ inventas y le repites a Meta al registrar el webhook.
# Este repo es público: no la dejes en un valor conocido.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Kapso: X-API-Key desde Project settings → API Keys
KAPSO_API_KEY=
KAPSO_BASE_URL=https://api.kapso.ai/platform/v1
# El número en Kapso. Lo necesita el registro del webhook.
KAPSO_PHONE_NUMBER_ID=

# ⚠️ Secreto con el que el proveedor firma cada entrega (HMAC-SHA256 del
# cuerpo crudo). SIN ESTO EL WEBHOOK ACEPTA CUALQUIER COSA: está en internet
# y cualquiera podría inventar una emergencia. Kapso lo manda en
# X-Webhook-Signature; Meta en X-Hub-Signature-256.
# Vacío = no verifica, y lo avisa en el log. En producción, ponlo.
WHATSAPP_WEBHOOK_SECRET=

# ── Twilio ───────────────────────────────────────────────────────
# TWILIO_PHONE_NUMBER es el "from" y acepta un Verified Caller ID:
# no hace falta comprar un número para que funcione.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Idempotencia de webhooks ─────────────────────────────────────
# Postgres donde vive `webhook_recibido` (migración 0003). Es la MISMA base de
# core: `voz` no tiene base propia y no la necesita.
#
# Vacía = deduplicación EN MEMORIA. Se pierde al reiniciar y no se comparte
# entre instancias — y es justo con dos instancias en Render donde un reintento
# de Meta despacha dos ambulancias al mismo paciente. `GET /listo` lo dice en
# `deduplicacion.modo`; míralo antes de asumir que está persistida.
#
# Si ya pusiste PULSO_ROUTING_DATABASE_URL (la de core), esta se puede omitir:
# se lee esa.
PULSO_WEBHOOK_DATABASE_URL=

# ── Seguridad ────────────────────────────────────────────────────
# Protege POST /telefonia/llamar y todo /interno/*, que gastan dinero real
# y viven en el mismo servicio público que los webhooks.
# Vacío = abierto (sólo para local). En Render ponlo SIEMPRE.
SECRETO_ENDPOINT=
