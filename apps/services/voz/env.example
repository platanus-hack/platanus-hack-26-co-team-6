# voz — configuración. Copiar a .env y ajustar.
# Todo tiene default en código, así que el servicio arranca sin .env.

LOG_LEVEL=INFO
PORT=8090

# ── Hacia adentro ────────────────────────────────────────────────
AI_CORE_BASE_URL=http://127.0.0.1:8000
CORE_BASE_URL=http://127.0.0.1:3001

# core niega por defecto: expone dictado clínico, diagnóstico y las
# coordenadas del paciente. Es la MISMA contraseña de turno que usan las
# consolas (OPERADOR_PASSWORD en apps/backend/core/.env).
# Vacía = no se manda Authorization, para un core sin el guard activo.
CORE_PASSWORD=
TIMEOUT_IA_S=30
TIMEOUT_CORE_S=10

# ── URL pública ──────────────────────────────────────────────────
# Donde Twilio y Meta pueden alcanzarnos.
#   local:  ngrok http 8090  → pega la URL https que te dé
#   Render: la URL del servicio (el blueprint la inyecta sola)
# Twilio la NECESITA: abre un WebSocket de vuelta para el audio.
URL_PUBLICA=

# ── WhatsApp ─────────────────────────────────────────────────────
# meta = Cloud API directo · kapso = a través de Kapso
WHATSAPP_PROVEEDOR=meta

# Cadena que TÚ inventas y le repites a Meta al registrar el webhook.
# Este repo es público: no la dejes en un valor conocido.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

KAPSO_API_KEY=
KAPSO_BASE_URL=https://app.kapso.ai/api/v1

# ── Twilio ───────────────────────────────────────────────────────
# TWILIO_PHONE_NUMBER es el "from" y acepta un Verified Caller ID:
# no hace falta comprar un número para que funcione.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Seguridad ────────────────────────────────────────────────────
# Protege POST /telefonia/llamar y todo /interno/*, que gastan dinero real
# y viven en el mismo servicio público que los webhooks.
# Vacío = abierto (sólo para local). En Render ponlo SIEMPRE.
SECRETO_ENDPOINT=
