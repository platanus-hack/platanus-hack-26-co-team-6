# frontend configuration. Copy to .env.local and adjust.
#
# TODO lo que hay aquí es PÚBLICO: NEXT_PUBLIC_* se compila dentro del bundle
# que se descarga el navegador. Ninguna credencial de servidor va aquí.
# Las llaves de Supabase (service role), Mapbox y Anthropic viven en
# apps/backend/core/.env y NUNCA salen de ahí.

# Base URL de core (NestJS). Default: http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# Token PÚBLICO de Mapbox GL, solo para pintar el mapa en /campo.
# Es distinto del MAPBOX_TOKEN de core, que se usa para la Matrix API.
# NEXT_PUBLIC_MAPBOX_TOKEN=

# Supabase para Realtime desde el navegador. La llave anon está sujeta a RLS;
# la service role NO va aquí bajo ninguna circunstancia.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
