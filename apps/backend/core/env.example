# core configuration. Copy to .env and adjust.
# Every value has a working default in code, so the service boots with no .env.

# Port Nest binds. Default: 3001 (3000 belongs to apps/frontend)
PORT=3001

# Browser origin allowed by CORS. Default: http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Servicio interno de IA. Si está puesta, POST /triage intenta resolver el
# dictado en ai-core ANTES de resolverlo localmente. Si ai-core no responde,
# tarda de más o devuelve basura, core sigue con su camino de siempre — la
# variable no agrega un punto de falla, agrega un primer intento.
#
# Déjala vacía o coméntala para que core resuelva todo local.
# El campo `via` de la respuesta dice cuál corrió.
AI_CORE_BASE_URL=http://localhost:8000

# Presupuesto para una llamada de inferencia a ai-core. Default: 30000.
# Pasado esto, core cae a su camino local en vez de esperar. El probe de
# /health/ai-core usa 2s fijos y no se configura.
# AI_CORE_TIMEOUT_MS=30000

# ── Credenciales de servidor ──────────────────────────────────────
# Estas NUNCA van en apps/frontend: se saltan RLS o cuestan dinero.

# Supabase. La service role key ignora Row Level Security.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=

# Mapbox Matrix API (ETA con tráfico). Sin token, estima por distancia.
# MAPBOX_TOKEN=

# Claude para el parser clínico. Sin key, cae al extractor heurístico.
# Si usas ai-core, la key puede vivir SOLO allá (apps/backend/ai-core/.env) y
# core queda sin credencial de proveedor. Es la topología que quiere el
# design.md del scaffold. Tenerla en los dos lados también funciona: core la
# usa como respaldo si ai-core no responde.
# ANTHROPIC_API_KEY=

# Telegram: canal primario del handshake. Sin token, loguea a consola.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID_DEMO=

# WhatsApp Cloud API: la vitrina. Requiere ventana de 24h abierta.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TO_DEMO=

# URL pública del front, para los enlaces de los botones. Default: CORS_ORIGIN
# PUBLIC_APP_URL=http://localhost:3000
