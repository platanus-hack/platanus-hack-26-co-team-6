# core configuration. Copy to .env and adjust.
# Every value has a working default in code, so the service boots with no .env.

# Port Nest binds. Default: 3001 (3000 belongs to apps/frontend)
PORT=3001

# Browser origin allowed by CORS. Default: http://localhost:3000
# NUNCA '*': core manda cookie de sesión, y con credenciales el navegador
# exige un origen exacto.
CORS_ORIGIN=http://localhost:3000

# Base URL of the internal ai-core service. Default: http://localhost:8000
AI_CORE_BASE_URL=http://localhost:8000

# ── Sesión de operador ────────────────────────────────────────────
# core NO se sirve sin autenticar: expone dictado clínico, diagnóstico y las
# coordenadas del paciente. Si dejas estas dos en blanco, arranca igual pero
# genera credenciales aleatorias y las imprime en el log — nunca queda abierto.

# Contraseña compartida del turno. La piden /campo, /hospital y /crue.
# OPERADOR_PASSWORD=

# Clave para firmar la cookie de sesión (HMAC). Mínimo 16 caracteres.
#   openssl rand -hex 32
# Si falta, se usa una aleatoria en memoria: las sesiones mueren al reiniciar.
# SESION_SECRET=

# Ponlo en 'true' SOLO si front y core viven en dominios distintos. Cambia la
# cookie a SameSite=None y exige HTTPS. En localhost déjalo fuera.
# COOKIE_CROSS_SITE=false

# ── Credenciales de servidor ──────────────────────────────────────
# Estas NUNCA van en apps/frontend: se saltan RLS o cuestan dinero.

# Supabase. La service role key ignora Row Level Security.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=

# Mapbox Matrix API (ETA con tráfico). Sin token, estima por distancia.
# MAPBOX_TOKEN=

# Claude para el parser clínico. Sin key, cae al extractor heurístico.
# ANTHROPIC_API_KEY=

# Deepgram: transcripción del dictado en el servidor.
# Sin esto /campo usa la Web Speech API del navegador, que NO existe en
# Safari/iOS — ahí el paramédico se queda sin dictado y tiene que teclear.
#
# core nunca le pasa esta key al navegador. Según los permisos que tenga,
# elige solo uno de dos caminos (ver src/voz/voz.service.ts):
#   · key con permiso de crear credenciales → POST /voz/token, el navegador
#     transcribe en vivo por WebSocket con un token que caduca en 5 minutos.
#   · key normal → POST /voz/transcribir, el navegador manda el audio y core
#     lo transcribe. Es el camino que aguanta zonas muertas, porque el audio
#     se puede guardar y reintentar.
# GET /capacidades dice cuál quedó activo.
# DEEPGRAM_API_KEY=

# Modelo e idioma de transcripción. Los defaults (nova-2 / es-419) son los
# adecuados para español colombiano; están aquí por si Deepgram los cambia.
# DEEPGRAM_MODELO=nova-2
# DEEPGRAM_IDIOMA=es-419

# ── Plazos de operación ───────────────────────────────────────────
# Segundos que una solicitud espera respuesta del hospital antes de vencer y
# pasar al siguiente candidato. Default: 45 (ver src/common/plazos.ts).
# Bájalo a 5-10 para ensayar el demo sin esperar de verdad.
# HANDSHAKE_TIMEOUT_S=45

# Telegram: canal primario del handshake. Sin token, loguea a consola.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID_DEMO=

# OBLIGATORIO si usas el webhook. El webhook es la única ruta pública que
# cambia estado clínico, así que se autentica con este secreto compartido:
# lo inventas tú, se lo pasas a Telegram en setWebhook(secret_token=...) y
# core compara el header X-Telegram-Bot-Api-Secret-Token de cada entrega.
# Sin esto el webhook rechaza todo. Ver telegram.controller.ts.
#   openssl rand -hex 32
# TELEGRAM_WEBHOOK_SECRET=

# WhatsApp Cloud API: la vitrina. Requiere ventana de 24h abierta.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TO_DEMO=

# URL pública del front, para los enlaces de los botones. Default: CORS_ORIGIN
# PUBLIC_APP_URL=http://localhost:3000
