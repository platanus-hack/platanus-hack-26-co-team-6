# ai-core configuration. Copy to .env and adjust.
# Every value has a working default in code, so the service boots with no .env.

# Nivel de log. Default: INFO
LOG_LEVEL=INFO

# ── Credenciales de proveedor ────────────────────────────────────
# Viven aquí y SOLO aquí. Ni `core` ni el frontend deben tenerlas.
# Vacío = /v1/triage responde igual, con el extractor heurístico
# (confianza 0.35, motor "heuristica"). El endpoint nunca falla por
# falta de credencial.
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# ── Parser clínico ───────────────────────────────────────────────
MODELO_TRIAGE=claude-opus-5
# "low" es una decisión de LATENCIA, no de costo: es el número del pitch.
# Si la calidad falla en los dictados feos, subir a "medium" y volver a
# medir con `uv run python -m evals.run --esfuerzo medium`.
ESFUERZO_TRIAGE=low
