# ai-core configuration. Copy to .env and adjust.
# Every value has a working default in code, so the service boots with no .env.

# Nivel de log. Default: INFO
LOG_LEVEL=INFO

# ── Credenciales de proveedor ────────────────────────────────────
# Viven aquí y SOLO aquí. Ni `core` ni el frontend deben tenerlas.
# Vacío = /v1/triage responde igual, con el extractor heurístico
# (confianza 0.35, motor "heuristica"). El endpoint nunca falla por
# falta de credencial.
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# ── Parser clínico ───────────────────────────────────────────────
MODELO_TRIAGE=claude-opus-5
# "low" es una decisión de LATENCIA, no de costo: es el número del pitch.
# Si la calidad falla en los dictados feos, subir a "medium" y volver a
# medir con `uv run python -m evals.run --esfuerzo medium`.
ESFUERZO_TRIAGE=low

# ── Transcripción (STT) ──────────────────────────────────────────
# Claude NO recibe audio: toma texto, imágenes y PDFs. Una nota de voz de
# WhatsApp necesita este paso antes del triaje.
#
# ⚠️ AQUÍ NO HAY HEURÍSTICA A LA QUE CAER. Todo el resto de PULSO degrada con
#    gracia cuando falta una credencial; esto no puede. Sin proveedor,
#    /v1/transcribir devuelve 503 explícito en vez de fingir.
#
#    El dictado desde la PWA usa Web Speech API en el navegador — gratis,
#    instantáneo, sin dependencias. Esto es sólo para el audio de WhatsApp.

# auto = usa el que tenga credencial (Deepgram primero, es el más rápido).
# deepgram | elevenlabs lo fuerzan. ninguno lo apaga.
STT_PROVEEDOR=auto

# https://console.deepgram.com  → API Keys
DEEPGRAM_API_KEY=
# https://elevenlabs.io → Profile → API Key
ELEVENLABS_API_KEY=

# nova-3 es el modelo actual de Deepgram; scribe_v2 el de ElevenLabs.
STT_MODELO_DEEPGRAM=nova-3
STT_MODELO_ELEVENLABS=scribe_v2

# Español. Fijarlo evita que el modelo dude con la jerga clínica.
STT_IDIOMA=es

# Un dictado de ambulancia dura segundos. Si no vuelve en 20s, algo anda mal.
STT_TIMEOUT_S=20
